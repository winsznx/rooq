{
  "name": "@rooq/private-sdk",
  "version": "0.1.0",
  "description": "Client SDK for Rooq private spot and perps on Robinhood Chain testnet: keys, notes, encryption, Merkle trees, witnesses and UltraHonk proving.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy/v1": {
      "types": "./dist/legacy/v1.d.ts",
      "import": "./dist/legacy/v1.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/admin.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsznx/rooq.git",
    "directory": "packages/private-sdk"
  },
  "homepage": "https://docs.rooq.trade/api-and-sdk",
  "bugs": {
    "url": "https://github.com/winsznx/rooq/issues"
  },
  "keywords": [
    "rooq",
    "zero-knowledge",
    "noir",
    "ultrahonk",
    "barretenberg",
    "privacy",
    "perpetuals",
    "spot",
    "robinhood-chain",
    "sdk"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@aztec/bb.js": "5.3.0",
    "@noir-lang/noir_js": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
