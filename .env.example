# Public web configuration (safe to expose)
NEXT_PUBLIC_ROOQ_ENV=testnet            # local | local-fork | testnet. Mainnet is not supported.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8700/api/v1
NEXT_PUBLIC_MAKER_URL=http://127.0.0.1:8701
NEXT_PUBLIC_MARKET_REGISTRY_ADDRESS=      # filled from packages/config after a real broadcast
NEXT_PUBLIC_LOCAL_TEST_WALLET=0           # 1 only for local anvil E2E

# Services
ROOQ_ENV=testnet
RPC_URL=https://rpc.testnet.chain.robinhood.com
API_URL=http://127.0.0.1:8700/api/v1
DATABASE_URL=postgres://user:password@localhost:5432/rooq    # placeholder
REDIS_URL=redis://localhost:6379                             # placeholder, not used yet
ROOQ_ALLOWED_ORIGINS=http://localhost:3200
MAKER_SIGNER_PROVIDER=env                 # env for testnet; a KMS-backed signer before any real funds
SENTRY_DSN=

# Keys: never commit real values. Use a secret manager.
DEPLOYER_PRIVATE_KEY=
MAKER_PRIVATE_KEY=
MAKER_ADDRESS=
QUOTE_SIGNER_PRIVATE_KEY=
ORACLE_OPERATOR_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
NEXT_PUBLIC_DOCS_URL=https://docs.rooq.trade   # the docs site; every in-app docs link follows this value
NEXT_PUBLIC_APP_URL=https://rooq.trade         # used by the docs site for links back to the app
NEXT_PUBLIC_SUPPORT_EMAIL=support@rooq.trade   # shown in the terms and privacy policy
